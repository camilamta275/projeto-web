# Exemplo de variáveis de ambiente do backend
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Banco de Dados
# Ajuste a URL abaixo de acordo com seu banco PostgreSQL
DATABASE_URL="postgresql://postgres:BacoExu@localhost:5432/Fiscalize?schema=public"

# JWT
# Chave secreta para assinar tokens JWT (altere em produção!)
JWT_SECRET="chave_secreta_super_segura"

# Expiração do token JWT (ex: "24h", "7d", "1w")
JWT_EXPIRATION="24h"

# Servidor
# Porta em que o servidor Express rodará
PORT=3000

# Frontend URL (para CORS)
# URL do frontend para permitir requisições cross-origin
FRONTEND_URL="http://localhost:3001"

# Ambiente
# Define o ambiente: 'development', 'production', 'test'
NODE_ENV="development"
