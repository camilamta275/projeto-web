# Exemplo de variáveis de ambiente do backend
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Banco de Dados
# Ajuste a URL abaixo de acordo com seu banco PostgreSQL
DATABASE_URL="postgresql://postgres:BacoExu@localhost:5432/Fiscalize?schema=public"

# JWT
# Chave secreta para assinar tokens JWT (altere em produção!)
JWT_SECRET="chave_secreta_super_segura"

# Expiração do token JWT (ex: "24h", "7d", "1w")
JWT_EXPIRATION="24h"

# Servidor
# Porta em que o servidor Express rodará
PORT=3000

# Frontend URL (para CORS)
# URL do frontend para permitir requisições cross-origin
FRONTEND_URL="http://localhost:3001"

# Ambiente
# Define o ambiente: 'development', 'production', 'test'
NODE_ENV="development"

# Seed - Usuário Admin Inicial
# Email do usuário admin criado no seed (opcional, padrão: admin@fiscalize.gov.br)
SEED_ADMIN_EMAIL="admin@fiscalize.gov.br"

# Senha do usuário admin criado no seed (opcional, padrão: Admin@123456)
# ⚠️ ALTERE ESTA SENHA EM PRODUÇÃO!
SEED_ADMIN_PASSWORD="Admin@123456"

# Nome do usuário admin criado no seed (opcional, padrão: Administrador)
SEED_ADMIN_NAME="Administrador"

# Redis
# URL de conexão com o Redis (cache de métricas e snapshots)
REDIS_URL="redis://localhost:6379"

# Cron — Consolidação de Métricas
# Expressão cron para o job de consolidação (padrão: a cada hora)
CRON_METRICS_SCHEDULE="0 * * * *"

# Test environment template — copy to .env.test for automated tests
# DATABASE_URL="postgresql://postgres:password@localhost:5432/Fiscalize_test?schema=public"
# REDIS_URL=
# NODE_ENV=test
